#!/usr/bin/make -f

%:
	dh $@

override_dh_auto_install:
	install -D -m 0755 service-panel debian/service-panel/usr/bin/service-panel
	install -D -m 0644 data/local.ServicePanel.desktop debian/service-panel/usr/share/applications/local.ServicePanel.desktop
	install -D -m 0644 data/local.ServicePanel.policy debian/service-panel/usr/share/polkit-1/actions/local.ServicePanel.policy
